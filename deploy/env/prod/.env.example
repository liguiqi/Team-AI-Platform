COMPOSE_PROJECT_NAME=ai-gateway-chat
TZ=Asia/Shanghai
NEW_API_VERSION=v0.12.1
LIBRECHAT_VERSION=v0.8.4
POSTGRES_VERSION=16-alpine
REDIS_VERSION=7.4.2-alpine
MONGO_VERSION=8.0.20
MEILISEARCH_VERSION=v1.35.1
CADDY_VERSION=2.10.0-alpine
LIBRECHAT_PORT=3080
NEW_API_PORT=3000
LIBRECHAT_PUBLIC_URL=https://chat.example.com
NEW_API_PUBLIC_URL=https://new-api.example.com
NEW_API_INTERNAL_URL=http://new-api:3000
NEW_API_DB_NAME=new_api
NEW_API_DB_USER=newapi
NEW_API_DB_PASSWORD=__FILL_STRONG_PASSWORD__
NEW_API_REDIS_PASSWORD=__FILL_STRONG_PASSWORD__
NEW_API_SESSION_SECRET=__FILL_32_PLUS_RANDOM__
NEW_API_SETUP_USERNAME=admin
NEW_API_SETUP_PASSWORD=__FILL_STRONG_PASSWORD__
NEW_API_SELF_USE_MODE_ENABLED=true
NEW_API_DEMO_SITE_ENABLED=false
NEW_API_SERVICE_USER=librechat
NEW_API_SERVICE_PASSWORD=__FILL_STRONG_PASSWORD__
NEW_API_SERVICE_DISPLAY_NAME="LibreChat Service"
NEW_API_SERVICE_TOKEN_NAME=librechat-service
NEW_API_SERVICE_TOKEN_QUOTA=5000000
NEW_API_SERVICE_TOKEN_UNLIMITED=false
NEW_API_SERVICE_TOKEN_GROUP=default
NEW_API_TOKEN_ALLOWED_MODELS=zhipu-primary
NEW_API_TOKEN_MODEL_LIMITS_ENABLED=false
NEW_API_SYNC_CHANNEL_MODELS_FROM_ENV=false
NEW_API_SERVICE_TOKEN=__AUTO_WRITTEN_BY_BOOTSTRAP__
NEW_API_RATE_LIMIT_ENABLED=true
NEW_API_RATE_LIMIT_WINDOW_MINUTES=1
NEW_API_RATE_LIMIT_TOTAL=60
NEW_API_RATE_LIMIT_SUCCESS=50
NEW_API_RATE_LIMIT_GROUP_JSON='{"default":[60,50]}'
ZHIPU_ENABLED=true
ZHIPU_API_KEY=__FILL_BY_USER__
ZHIPU_API_BASE_URL=https://open.bigmodel.cn
ZHIPU_DEFAULT_MODEL=glm-4-flash
ZHIPU_TEST_MODEL=glm-4-flash
ZHIPU_EXPOSED_MODEL=zhipu-primary
ZHIPU_CHANNEL_NAME=zhipu-primary
ZHIPU_CHANNEL_TYPE=26
ZHIPU_CHANNEL_GROUP=default
ZHIPU_CHANNEL_PRIORITY=10
ZHIPU_CHANNEL_WEIGHT=100
ZHIPU_MODEL_MAPPING_JSON='{"zhipu-primary":"glm-4-flash"}'
ZHIPU_CHANNEL_REMARK="Primary Zhipu channel for acceptance"
LIBRECHAT_HOST=0.0.0.0
LIBRECHAT_SEARCH_ENABLED=false
LIBRECHAT_MEILI_MASTER_KEY=__FILL_32_PLUS_RANDOM__
LIBRECHAT_CREDS_KEY=__FILL_64_HEX__
LIBRECHAT_CREDS_IV=__FILL_32_HEX__
LIBRECHAT_JWT_SECRET=__FILL_64_HEX__
LIBRECHAT_JWT_REFRESH_SECRET=__FILL_64_HEX__
LIBRECHAT_ALLOW_EMAIL_LOGIN=true
LIBRECHAT_ALLOW_REGISTRATION=false
LIBRECHAT_ALLOW_SOCIAL_LOGIN=false
LIBRECHAT_ALLOW_PASSWORD_RESET=false
LIBRECHAT_ALLOW_SHARED_LINKS=false
LIBRECHAT_FETCH_MODELS=true
LIBRECHAT_VISIBLE_MODELS=
LIBRECHAT_ENDPOINT_NAME=NEW-API
LIBRECHAT_DEFAULT_MODELS=zhipu-primary
LIBRECHAT_TITLE_MODEL=zhipu-primary
LIBRECHAT_MODEL_LABEL="Team AI"
LIBRECHAT_SESSION_EXPIRY=900000
LIBRECHAT_REFRESH_TOKEN_EXPIRY=604800000
PUBLIC_CHAT_DOMAIN=chat.example.com
NEW_API_ADMIN_DOMAIN=new-api.example.com
ACME_EMAIL=ops@example.com
BOOTSTRAP_AUTOCONFIGURE=false
