# 本文件是本地开发的默认环境模板
# 复制为 .env 后执行 make init

COMPOSE_PROJECT_NAME=ai-gateway-chat
TZ=Asia/Shanghai

NEW_API_VERSION=v0.12.1
LIBRECHAT_VERSION=v0.8.5
CASDOOR_VERSION=2.396.1
POSTGRES_VERSION=16-alpine
REDIS_VERSION=7.4.2-alpine
MONGO_VERSION=8.0.20
MEILISEARCH_VERSION=v1.35.1
CADDY_VERSION=2.10.0-alpine

LIBRECHAT_PORT=3080
NEW_API_PORT=13000
CASDOOR_PORT=18000

LIBRECHAT_PUBLIC_URL=http://localhost:3080
NEW_API_PUBLIC_URL=http://localhost:13000
CASDOOR_PUBLIC_URL=http://localhost:18000
NEW_API_INTERNAL_URL=http://new-api:3000

NEW_API_DB_NAME=new_api
NEW_API_DB_USER=newapi
NEW_API_DB_PASSWORD=__FILL_16_PLUS_RANDOM__
NEW_API_REDIS_PASSWORD=__FILL_16_PLUS_RANDOM__
NEW_API_SESSION_SECRET=__FILL_32_PLUS_RANDOM__

NEW_API_SETUP_USERNAME=admin
NEW_API_SETUP_PASSWORD=ChangeMe_Admin_123
NEW_API_SELF_USE_MODE_ENABLED=true
NEW_API_DEMO_SITE_ENABLED=false

NEW_API_SERVICE_USER=librechat
NEW_API_SERVICE_PASSWORD=__PLACEHOLDER_PASSWORD__
NEW_API_SERVICE_DISPLAY_NAME="LibreChat Service"
NEW_API_SERVICE_TOKEN_NAME=librechat-service
NEW_API_SERVICE_TOKEN_QUOTA=5000000
NEW_API_SERVICE_TOKEN_UNLIMITED=false
NEW_API_SERVICE_TOKEN_GROUP=default
NEW_API_TOKEN_ALLOWED_MODELS=zhipu-primary
NEW_API_TOKEN_MODEL_LIMITS_ENABLED=false
NEW_API_SYNC_CHANNEL_MODELS_FROM_ENV=true
NEW_API_SERVICE_TOKEN=__AUTO_WRITTEN_BY_BOOTSTRAP__

NEW_API_RATE_LIMIT_ENABLED=true
NEW_API_RATE_LIMIT_WINDOW_MINUTES=1
NEW_API_RATE_LIMIT_TOTAL=60
NEW_API_RATE_LIMIT_SUCCESS=50
NEW_API_RATE_LIMIT_GROUP_JSON='{"default":[60,50]}'

ZHIPU_ENABLED=true
ZHIPU_API_KEY=__FILL_BY_USER__
ZHIPU_API_BASE_URL=https://open.bigmodel.cn
ZHIPU_DEFAULT_MODEL=glm-4-flash-250414
ZHIPU_TEST_MODEL=glm-4-flash-250414
ZHIPU_EXPOSED_MODEL=glm-5.1,glm-5,glm-5-turbo,glm-4.7,glm-4.7-flash,glm-4.7-flashx,glm-4.6,glm-4.5-air,glm-4.5-airx,glm-4.5-flash,glm-4-long,glm-4-flashx-250414,glm-4-flash-250414,glm-5v-turbo,glm-4.6v,glm-4.6v-flash,glm-4.1v-thinking-flashx,glm-4.1v-thinking-flash,glm-4v-flash
ZHIPU_CHANNEL_NAME=zhipu-primary
ZHIPU_CHANNEL_TYPE=26
ZHIPU_CHANNEL_GROUP=default
ZHIPU_CHANNEL_PRIORITY=10
ZHIPU_CHANNEL_WEIGHT=100
ZHIPU_MODEL_MAPPING_JSON='{}'
ZHIPU_CHANNEL_REMARK="Primary Zhipu channel for acceptance"

CASDOOR_DB_NAME=casdoor
CASDOOR_APPLICATION_NAME=team-ai-librechat
CASDOOR_APPLICATION_DISPLAY_NAME="Team AI Platform SSO"
CASDOOR_USER_ORGANIZATION_NAME=team-ai
CASDOOR_USER_ORGANIZATION_DISPLAY_NAME="Team AI Platform"
CASDOOR_USER_ORGANIZATION_WEBSITE_URL=
CASDOOR_CLIENT_ID=team-ai-librechat
CASDOOR_CLIENT_SECRET=__FILL_32_PLUS_RANDOM__
CASDOOR_ADMIN_EMAIL=ops@example.com
CASDOOR_ADMIN_PHONE=
CASDOOR_ADMIN_COUNTRY_CODE=CN
CASDOOR_ADMIN_PASSWORD=__FILL_16_PLUS_RANDOM__
CASDOOR_VERIFICATION_CODE_TIMEOUT=5
CASDOOR_INIT_DATA_NEW_ONLY=false
CASDOOR_EMAIL_PROVIDER_NAME=team-ai-email
CASDOOR_EMAIL_SMTP_HOST=__FILL_BY_USER__
CASDOOR_EMAIL_SMTP_PORT=465
CASDOOR_EMAIL_SMTP_USERNAME=__FILL_BY_USER__
CASDOOR_EMAIL_SMTP_PASSWORD=__FILL_BY_USER__
CASDOOR_EMAIL_SSL_MODE=Enable
CASDOOR_EMAIL_FROM_ADDRESS=__FILL_BY_USER__
CASDOOR_EMAIL_FROM_NAME="Team AI Platform"
CASDOOR_EMAIL_SUBJECT="Team AI Platform 验证码"
LOCAL_SMTP_RELAY_ENABLED=false
LOCAL_SMTP_RELAY_HOST=host.docker.internal
LOCAL_SMTP_RELAY_BIND_HOST=0.0.0.0
LOCAL_SMTP_RELAY_PORT=2525
CASDOOR_SMS_PROVIDER_NAME=team-ai-pnvs
CASDOOR_SMS_ACCESS_KEY_ID=__FILL_BY_USER__
CASDOOR_SMS_ACCESS_KEY_SECRET=__FILL_BY_USER__
CASDOOR_SMS_SIGN_NAME=__FILL_BY_USER__
CASDOOR_SMS_TEMPLATE_CODE=__FILL_BY_USER__
CASDOOR_SMS_REGION_ID=cn-hangzhou
CASDOOR_THEME_IS_ENABLED=true
CASDOOR_THEME_TYPE=dark
CASDOOR_THEME_COLOR_PRIMARY=#10a37f
CASDOOR_THEME_BORDER_RADIUS=10
CASDOOR_THEME_IS_COMPACT=false
CASDOOR_APPLICATION_THEME_IS_ENABLED=true
CASDOOR_APPLICATION_THEME_TYPE=dark
CASDOOR_APPLICATION_THEME_COLOR_PRIMARY=#10a37f
CASDOOR_APPLICATION_THEME_BORDER_RADIUS=10
CASDOOR_APPLICATION_THEME_IS_COMPACT=false

LIBRECHAT_HOST=0.0.0.0
LIBRECHAT_MONGODB_LOCAL_PORT=27017
LIBRECHAT_SEARCH_ENABLED=false
LIBRECHAT_MEILI_MASTER_KEY=__FILL_32_PLUS_RANDOM__
LIBRECHAT_CREDS_KEY=__FILL_64_HEX__
LIBRECHAT_CREDS_IV=__FILL_32_HEX__
LIBRECHAT_JWT_SECRET=__FILL_64_HEX__
LIBRECHAT_JWT_REFRESH_SECRET=__FILL_64_HEX__
LIBRECHAT_OPENID_SESSION_SECRET=__FILL_32_PLUS_RANDOM__
LIBRECHAT_OPENID_SCOPE="openid profile email phone"
LIBRECHAT_OPENID_BUTTON_LABEL="统一认证登录"
LIBRECHAT_OPENID_REUSE_TOKENS=true
LIBRECHAT_OPENID_AUTO_REDIRECT=true
LIBRECHAT_OPENID_MAX_LOGOUT_URL_LENGTH=8192
LIBRECHAT_OPENID_ALLOW_INSECURE_HTTP=true
LIBRECHAT_ALLOW_EMAIL_LOGIN=false
LIBRECHAT_ALLOW_REGISTRATION=false
LIBRECHAT_ALLOW_SOCIAL_LOGIN=true
LIBRECHAT_ALLOW_PASSWORD_RESET=false
LIBRECHAT_ALLOW_SHARED_LINKS=false
LIBRECHAT_FETCH_MODELS=true
LIBRECHAT_VISIBLE_MODELS=
# 留空时渲染脚本会回退为 ZHIPU_EXPOSED_MODEL 作为 default 列表，实际可见模型仍由 fetch/models 决定
LIBRECHAT_ENDPOINT_NAME=NEW-API
LIBRECHAT_DEFAULT_MODELS=
LIBRECHAT_TITLE_MODEL=glm-4-flash-250414
LIBRECHAT_MODEL_LABEL="Team AI"
LIBRECHAT_SESSION_EXPIRY=900000
LIBRECHAT_REFRESH_TOKEN_EXPIRY=604800000

PUBLIC_CHAT_DOMAIN=chat.example.com
NEW_API_ADMIN_DOMAIN=new-api.example.com
AUTH_PUBLIC_DOMAIN=auth.example.com
ACME_EMAIL=ops@example.com

PLATFORM_THEME_MODE=system
PLATFORM_THEME_LOCK=false
PLATFORM_HIDE_THEME_SELECTOR=false
PLATFORM_BRAND_NAME="Team AI Platform"
PLATFORM_BRAND_LOGO_PATH=/images/team-ai-platform-logo.svg
PLATFORM_BRAND_FAVICON_PATH=/images/team-ai-platform-mark.svg
LIBRECHAT_ADMIN_ROLE=ADMIN
LIBRECHAT_ADMIN_PANEL_VERSION=latest
LIBRECHAT_ADMIN_PANEL_PORT=3001
LIBRECHAT_ADMIN_PANEL_SESSION_SECRET=__FILL_32_PLUS_RANDOM__

BOOTSTRAP_AUTOCONFIGURE=true
