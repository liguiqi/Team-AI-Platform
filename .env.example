# 本文件是本地开发的默认环境模板
# 复制为 .env 后执行 make init

COMPOSE_PROJECT_NAME=ai-gateway-chat
TZ=Asia/Shanghai

NEW_API_VERSION=v0.12.1
LIBRECHAT_VERSION=v0.8.5
CASDOOR_VERSION=2.396.1
POSTGRES_VERSION=16-alpine
REDIS_VERSION=7.4.2-alpine
MONGO_VERSION=8.0.20
MEILISEARCH_VERSION=v1.35.1
CADDY_VERSION=2.10.0-alpine

LIBRECHAT_PORT=3080
NEW_API_PORT=13000
CASDOOR_PORT=18000

LIBRECHAT_PUBLIC_URL=http://localhost:3080
NEW_API_PUBLIC_URL=http://localhost:13000
CASDOOR_PUBLIC_URL=http://localhost:18000
NEW_API_INTERNAL_URL=http://new-api:3000

NEW_API_DB_NAME=new_api
NEW_API_DB_USER=newapi
NEW_API_DB_PASSWORD=__FILL_16_PLUS_RANDOM__
NEW_API_REDIS_PASSWORD=__FILL_16_PLUS_RANDOM__
NEW_API_SESSION_SECRET=__FILL_32_PLUS_RANDOM__

NEW_API_SETUP_USERNAME=admin
NEW_API_SETUP_PASSWORD=ChangeMe_Admin_123
NEW_API_SELF_USE_MODE_ENABLED=true
NEW_API_DEMO_SITE_ENABLED=false

NEW_API_SERVICE_USER=librechat
NEW_API_SERVICE_PASSWORD=__PLACEHOLDER_PASSWORD__
NEW_API_SERVICE_DISPLAY_NAME="LibreChat Service"
NEW_API_SERVICE_TOKEN_NAME=librechat-service
NEW_API_SERVICE_TOKEN_QUOTA=1000000000000
NEW_API_SERVICE_TOKEN_UNLIMITED=true
NEW_API_SERVICE_TOKEN_GROUP=default
NEW_API_TOKEN_ALLOWED_MODELS=
NEW_API_TOKEN_MODEL_LIMITS_ENABLED=false
NEW_API_SYNC_CHANNEL_MODELS_FROM_ENV=true
NEW_API_PROVIDER_CHANNEL_BALANCE=999999999999
NEW_API_SERVICE_TOKEN=__AUTO_WRITTEN_BY_BOOTSTRAP__

NEW_API_RATE_LIMIT_ENABLED=false
NEW_API_RATE_LIMIT_WINDOW_MINUTES=1
NEW_API_RATE_LIMIT_TOTAL=60
NEW_API_RATE_LIMIT_SUCCESS=50
NEW_API_RATE_LIMIT_GROUP_JSON='{"default":[60,50]}'

ZHIPU_ENABLED=true
ZHIPU_API_KEY=__FILL_BY_USER__
ZHIPU_API_BASE_URL=https://open.bigmodel.cn
ZHIPU_DEFAULT_MODEL=glm-5.1
